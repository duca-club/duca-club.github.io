---
import DefaultLayout from "@layouts/DefaultLayout.astro";
import { RetroContactForm } from "@components/ui/retro-contact-form";

const contactMethods = [
  {
    title: "Discord",
    description: "The fastest way to reach us. Join our server and message any executive.",
    link: "https://discord.com/invite/duca",
    linkText: "Discord",
    icon: "💬",
    color: "#5865f2",
  },
  {
    title: "Email",
    description: "For formal inquiries, partnerships, or sponsorship discussions.",
    link: "mailto:info@duca.au",
    linkText: "Send Email",
    icon: "📧",
    color: "#3b82f6",
  },
  {
    title: "Instagram",
    description: "Follow us for event updates, photos, and community highlights.",
    link: "https://www.instagram.com/deakincyber/",
    linkText: "@deakincyber",
    icon: "📸",
    color: "#e1306c",
  },
  {
    title: "LinkedIn",
    description: "Connect with us professionally and stay updated on opportunities.",
    link: "https://linkedin.com/company/duca-club",
    linkText: "Follow Us",
    icon: "💼",
    color: "#0a66c2",
  },
];
---

<DefaultLayout title="Contact">
  <div class="section-themed relative min-h-screen overflow-hidden pt-32 pb-24">
    <!-- Seamless Grid Pattern across entire page background -->
    <div class="bg-grid-pattern absolute inset-0 opacity-15 pointer-events-none"></div>

    <!-- Soft, ambient cyberpunk glow at the top -->
    <div 
      class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-[1200px] h-[500px] rounded-full blur-3xl pointer-events-none z-0"
      style="background: radial-gradient(circle, rgba(59, 130, 246, 0.08) 0%, rgba(139, 92, 246, 0.03) 60%, transparent 100%);"
    ></div>

    <div class="relative z-10 container mx-auto px-4">
      <!-- Page Title -->
      <div class="text-center mb-16">
        <h1 class="mb-4 text-4xl font-bold text-white md:text-6xl">
          <span class="bg-linear-to-r from-blue-400 to-cyan-500 bg-clip-text text-transparent">Contact Hub</span>
        </h1>
        <p class="mx-auto max-w-2xl text-base text-gray-300">
          Choose a direct channel below or drop us a secure message using our retro mail terminal.
        </p>
      </div>

      <!-- Dashboard Workspace -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-stretch mb-24">
        <!-- Left Column: Retro Mail Terminal -->
        <div class="lg:col-span-7 space-y-6">
          <div class="mb-2">
            <h2 class="theme-text text-2xl font-bold md:text-3xl">Send Us a Message</h2>
            <p class="theme-text-secondary mt-2 text-sm">Use our retro mail terminal to drop us a line</p>
          </div>
          <RetroContactForm client:visible />
        </div>

        <!-- Right Column: Connections Grid -->
        <div class="lg:col-span-5 flex flex-col">
          <div class="mb-8">
            <h2 class="theme-text text-2xl font-bold md:text-3xl">Direct Channels</h2>
            <p class="theme-text-secondary mt-2 text-sm">Find us on our social and community channels</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 flex-1">
            {
              contactMethods.map((method, idx) => (
                <a
                  href={method.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="contact-funky-box group theme-card theme-border relative overflow-hidden rounded-xl border p-5 transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between h-full"
                  style={`--glow-color: ${method.color};`}
                >
                  <div class="relative z-10 flex flex-col justify-between h-full flex-1">
                    <div>
                      <div class="mb-3 inline-block text-3xl transition-transform group-hover:scale-110">{method.icon}</div>
                      <h3 class="theme-text mb-1 text-base font-bold">{method.title}</h3>
                      <p class="theme-text-secondary mb-3 text-xs line-clamp-3">{method.description}</p>
                    </div>
                    <span class="inline-flex items-center text-xs font-semibold transition-colors mt-auto" style={`color: ${method.color};`}>
                      {method.linkText}
                      <svg
                        class="ml-1.5 h-3.5 w-3.5 transition-transform group-hover:translate-x-1"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2.5"
                          d="M14 5l7 7m0 0l-7 7m7-7H3"
                        />
                      </svg>
                    </span>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Campus Coordinates -->
      <div class="mt-20">
        <div class="mb-12 text-center">
          <h2 class="theme-text text-3xl font-bold md:text-4xl">Campus Coordinates</h2>
          <p class="theme-text-secondary mt-3 max-w-2xl mx-auto">We operate across multiple Deakin University campuses</p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <div
            class="theme-card theme-border relative overflow-hidden rounded-2xl border p-8 transition-all duration-300 hover:-translate-y-1 hover:border-blue-500/30"
          >
            <div class="absolute top-0 right-0 p-4 font-mono text-xs text-blue-500/40">HQ_EAST</div>
            <h3 class="theme-text mb-4 text-xl font-bold flex items-center gap-2">
              <span class="text-2xl">📍</span> Burwood Campus
            </h3>
            <p class="theme-text-secondary">221 Burwood Hwy</p>
            <p class="theme-text-secondary mb-4">Burwood VIC 3125</p>
            <p class="theme-text-muted text-sm mb-6">Main meeting location for workshops, presentations, and cyber lab events.</p>
            <a
              href="https://maps.google.com/?q=Deakin+University+Burwood+Campus"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center text-sm font-semibold text-blue-400 hover:text-blue-300 transition-colors"
            >
              Open in Google Maps
              <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
          <div
            class="theme-card theme-border relative overflow-hidden rounded-2xl border p-8 transition-all duration-300 hover:-translate-y-1 hover:border-indigo-500/30"
          >
            <div class="absolute top-0 right-0 p-4 font-mono text-xs text-indigo-500/40">HQ_WEST</div>
            <h3 class="theme-text mb-4 text-xl font-bold flex items-center gap-2">
              <span class="text-2xl">📍</span> Geelong Waurn Ponds Campus
            </h3>
            <p class="theme-text-secondary">75 Pigdons Rd</p>
            <p class="theme-text-secondary mb-4">Waurn Ponds VIC 3216</p>
            <p class="theme-text-muted text-sm mb-6">Regular meetups, hackathons, and local events for our Geelong members.</p>
            <a
              href="https://maps.google.com/?q=Deakin+University+Waurn+Ponds+Campus"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center text-sm font-semibold text-indigo-400 hover:text-indigo-300 transition-colors"
            >
              Open in Google Maps
              <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</DefaultLayout>

<style>
  /* Funky box animated border */
  .contact-funky-box::before {
    position: absolute;
    opacity: 0;
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
    animation: rotate-border 4s linear infinite;
    transition: opacity 0.3s ease;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      var(--angle, 0deg),
      var(--glow-color) 0%,
      transparent 40%,
      transparent 60%,
      var(--glow-color) 100%
    );
    padding: 1px;
    content: "";
  }

  .contact-funky-box:hover::before {
    opacity: 1;
  }

  .contact-funky-box:hover {
    box-shadow: 0 0 30px color-mix(in srgb, var(--glow-color) 20%, transparent);
  }

  @keyframes rotate-border {
    to {
      --angle: 360deg;
    }
  }

  @property --angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }
</style>
