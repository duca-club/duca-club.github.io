---
import DefaultLayout from "@layouts/DefaultLayout.astro";
import { SectionHeading } from "@components/ui/section-heading";
import { AnimatedGradientBackground } from "@components/ui/animated-gradient";
import { RetroContactForm } from "@components/ui/retro-contact-form";

const contactMethods = [
  {
    title: "Discord",
    description: "The fastest way to reach us. Join our server and message any executive.",
    link: "https://discord.com/invite/duca",
    linkText: "Discord",
    icon: "💬",
    color: "#5865f2",
  },
  {
    title: "Email",
    description: "For formal inquiries, partnerships, or sponsorship discussions.",
    link: "mailto:info@duca.au",
    linkText: "Send Email",
    icon: "📧",
    color: "#3b82f6",
  },
  {
    title: "Instagram",
    description: "Follow us for event updates, photos, and community highlights.",
    link: "https://www.instagram.com/deakincyber/",
    linkText: "@deakincyber",
    icon: "📸",
    color: "#e1306c",
  },
  {
    title: "LinkedIn",
    description: "Connect with us professionally and stay updated on opportunities.",
    link: "https://linkedin.com/company/duca-club",
    linkText: "Follow Us",
    icon: "💼",
    color: "#0a66c2",
  },
];
---

<DefaultLayout title="Contact">
  <!-- Hero Section with Animated Gradient -->
  <section class="relative flex min-h-[50vh] items-center justify-center overflow-hidden">
    <AnimatedGradientBackground
      containerClassName="absolute inset-0 !min-h-0"
      gradientColors={["#3b82f6", "#06b6d4", "#6366f1", "#8b5cf6"]}
      client:load
    >
      <div></div>
    </AnimatedGradientBackground>
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="bg-grid-pattern absolute inset-0 opacity-20"></div>

    <div class="relative z-10 container mx-auto px-4 pt-40 pb-20 text-center">
      <h1 class="mb-6 text-5xl font-bold text-white md:text-7xl">
        <span class="bg-linear-to-r from-blue-400 to-cyan-500 bg-clip-text text-transparent">Contact Us</span>
      </h1>
      <p class="mx-auto max-w-2xl text-xl text-gray-300">
        Have questions? Want to partner with us? We'd love to hear from you!
      </p>
    </div>
  </section>

  <!-- Contact Methods - Funky Boxes -->
  <section class="section-themed data-stream-bg relative overflow-hidden py-24">
    <div class="relative z-10 container mx-auto px-4">
      <SectionHeading title="Get In Touch" subtitle="Choose your preferred way to reach us" client:visible />

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          contactMethods.map((method, idx) => (
            <a
              href={method.link}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-funky-box group theme-card theme-border relative overflow-hidden rounded-2xl border p-8 transition-all duration-300 hover:-translate-y-1"
              style={`--glow-color: ${method.color}; animation-delay: ${idx * 0.15}s;`}
            >
              <div class="relative z-10">
                <div class="mb-4 inline-block text-4xl transition-transform group-hover:scale-110">{method.icon}</div>
                <h3 class="theme-text mb-2 text-xl font-bold">{method.title}</h3>
                <p class="theme-text-secondary mb-4">{method.description}</p>
                <span class="inline-flex items-center font-medium transition-colors" style={`color: ${method.color};`}>
                  {method.linkText}
                  <svg
                    class="ml-2 h-4 w-4 transition-transform group-hover:translate-x-1"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M14 5l7 7m0 0l-7 7m7-7H3"
                    />
                  </svg>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Retro Contact Form -->
  <section class="section-themed-alt theme-border border-t py-24">
    <div class="container mx-auto px-4">
      <SectionHeading
        title="Send Us a Message"
        subtitle="Use our retro mail terminal to drop us a line"
        client:visible
      />

      <div class="mt-12">
        <RetroContactForm client:visible />
      </div>
    </div>
  </section>

  <!-- Discord CTA - Terminal Style -->
  <section class="section-themed theme-border border-t py-16">
    <div class="container mx-auto px-4">
      <div
        class="mx-auto max-w-2xl rounded-xl p-8 text-center font-mono"
        style="background: rgba(0,20,0,0.6); border: 1px solid rgba(51, 255, 51, 0.3); box-shadow: 0 0 30px rgba(51,255,51,0.08);"
      >
        <p class="mb-4 text-sm" style="color: rgba(51,255,51,0.6);">{">"} DUCA_NET // COMMUNITY_LINK</p>
        <p class="mb-6 text-lg" style="color: #33ff33; text-shadow: 0 0 10px rgba(51,255,51,0.4);">
          {">"} connect --server discord.com/invite/duca
          <span class="ml-1 animate-pulse">█</span>
        </p>
        <a
          href="https://discord.com/invite/duca"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-lg px-6 py-3 font-mono font-bold transition-all duration-200 hover:scale-105"
          style="background-color: #33ff33; color: #000; box-shadow: 0 0 20px rgba(51,255,51,0.4); text-shadow: none;"
        >
          [ENTER] Discord
        </a>
      </div>
    </div>
  </section>

  <!-- Location Info -->
  <section class="section-themed theme-border border-t py-24">
    <div class="container mx-auto px-4">
      <SectionHeading title="Find Us" subtitle="We're based at Deakin University campuses" client:visible />

      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2">
        <div
          class="theme-card theme-border rounded-2xl border p-8 transition-colors duration-300 hover:-translate-y-1 hover:border-blue-500/30"
        >
          <h3 class="theme-text mb-4 text-xl font-bold">Burwood Campus</h3>
          <p class="theme-text-secondary mb-2">221 Burwood Hwy</p>
          <p class="theme-text-secondary mb-2">Burwood VIC 3125</p>
          <p class="theme-text-muted text-sm">Main meeting location for most events</p>
        </div>
        <div
          class="theme-card theme-border rounded-2xl border p-8 transition-colors duration-300 hover:-translate-y-1 hover:border-blue-500/30"
        >
          <h3 class="theme-text mb-4 text-xl font-bold">Geelong Waurn Ponds Campus</h3>
          <p class="theme-text-secondary mb-2">75 Pigdons Rd</p>
          <p class="theme-text-secondary mb-2">Waurn Ponds VIC 3216</p>
          <p class="theme-text-muted text-sm">Regular events for Geelong members</p>
        </div>
      </div>
    </div>
  </section>
</DefaultLayout>

<style>
  /* Funky box animated border */
  .contact-funky-box::before {
    position: absolute;
    opacity: 0;
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
    animation: rotate-border 4s linear infinite;
    transition: opacity 0.3s ease;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      var(--angle, 0deg),
      var(--glow-color) 0%,
      transparent 40%,
      transparent 60%,
      var(--glow-color) 100%
    );
    padding: 1px;
    content: "";
  }

  .contact-funky-box:hover::before {
    opacity: 1;
  }

  .contact-funky-box:hover {
    box-shadow: 0 0 30px color-mix(in srgb, var(--glow-color) 20%, transparent);
  }

  @keyframes rotate-border {
    to {
      --angle: 360deg;
    }
  }

  @property --angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }
</style>
