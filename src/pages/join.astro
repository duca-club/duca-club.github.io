---
import DefaultLayout from "@layouts/DefaultLayout.astro";
import { Highlight } from "@components/ui/hero-highlight";
import { CardSpotlight } from "@components/ui/card-spotlight";
import { SectionHeading } from "@components/ui/section-heading";
import { SpotlightNew } from "@components/ui/spotlight";
import { WobbleCard } from "@components/ui/wobble-card";

const divisions = [
  {
    title: "Penetration Testing",
    description:
      "Research division exploring ethical hacking in a safe environment. Share with DUCA members how attackers think and how to stop them.",
    icon: "🔓",
    color: "#ef4444",
  },
  {
    title: "Networking",
    description:
      "Find people in industry across Cyber, AI, Development and recruitment to talk to DUCA members about getting into industry.",
    icon: "🌐",
    color: "#3b82f6",
  },
  {
    title: "Cyber Essentials",
    description: "Research and share the fundamentals of cybersecurity in a supportive environment.",
    icon: "🛡️",
    color: "#22c55e",
  },
  {
    title: "Capture The Flag",
    description: "Put on CTF event's for DUCA! Even compete in CTF competitions as a team.",
    icon: "🚩",
    color: "#a855f7",
  },
  {
    title: "Development",
    description: "Build cool software projects for the club and beyond. Perfect for aspiring developers!",
    icon: "💻",
    color: "#06b6d4",
  },
  {
    title: "Advertising",
    description: "Create engaging content and spread the word about DUCA's activities.",
    icon: "📢",
    color: "#f97316",
  },
];
---

<DefaultLayout title="Join Us">
  <!-- Hero Section with Group Photo Background -->
  <section class="section-themed relative flex min-h-[70vh] items-center justify-center overflow-hidden pt-40 pb-36">
    <div class="absolute inset-0 bg-linear-to-b from-pink-900/20 via-transparent to-transparent"></div>
    <SpotlightNew className="-top-40 left-0 md:-top-20 md:left-60" fill="#ec4899" client:load />
    <div class="bg-grid-white/[0.02] absolute inset-0 bg-size-[50px_50px]"></div>

    <!-- Background Image (pixelated effect would go here) -->
    <div class="absolute inset-0 opacity-20">
      <img
        src="/DUCA-Crew-Index.jpeg"
        alt=""
        class="h-full w-full object-cover"
        style="image-rendering: pixelated; filter: blur(2px);"
      />
    </div>

    <div class="relative z-10 container mx-auto px-4 py-20 text-center">
      <h1 class="mb-6 text-5xl font-bold text-white md:text-7xl">
        Join <Highlight className="text-white" client:load>DUCA</Highlight>
      </h1>
      <p class="mx-auto mb-8 max-w-2xl text-xl text-gray-300">
        Become part of Australia's leading student cybersecurity community. Whether you're a beginner or expert, there's
        a place for you here.
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="https://www.dusa.org.au/clubs/deakin-university-cybersecurity-association-burwood-duca"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-full bg-pink-600 px-8 py-4 text-lg font-semibold text-white transition-colors hover:bg-pink-700"
        >
          Regsiter
        </a>
        <a
          href="https://discord.com/invite/duca"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-full border-2 border-white/30 px-8 py-4 text-lg font-semibold text-white transition-colors hover:bg-white/10"
        >
          Discord
        </a>
      </div>
    </div>
  </section>

  <!-- How to Join - Community Info -->
  <section class="section-themed data-stream-bg relative overflow-hidden py-24">
    <div class="container mx-auto px-4">
      <SectionHeading title="How to Join" subtitle="Getting involved with DUCA is easy - here's how" client:visible />

      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
        <div
          class="theme-card theme-border relative rounded-2xl border p-8 text-center transition-all duration-300 hover:-translate-y-1 hover:border-pink-500/30"
        >
          <div
            class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full border border-pink-500/30 bg-pink-500/10"
          >
            <span class="text-3xl font-bold text-pink-400">1</span>
          </div>
          <h3 class="theme-text mb-3 text-xl font-bold">Sign Up via DUSA</h3>
          <p class="theme-text-secondary">
            Register as a DUCA member through the Deakin University Student Association. Membership gives you voting
            rights and full access to all club activities.
          </p>
          <a
            href="https://www.dusa.org.au/clubs/deakin-university-cybersecurity-association-burwood-duca"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-block font-medium text-pink-400 transition-colors hover:text-pink-300"
          >
            Regsiter on DUSA &rarr;
          </a>
        </div>

        <div
          class="theme-card theme-border relative rounded-2xl border p-8 text-center transition-all duration-300 hover:-translate-y-1 hover:border-purple-500/30"
        >
          <div
            class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full border border-purple-500/30 bg-purple-500/10"
          >
            <span class="text-3xl font-bold text-purple-400">2</span>
          </div>
          <h3 class="theme-text mb-3 text-xl font-bold">Join Our Discord</h3>
          <p class="theme-text-secondary">
            Our Discord is where the community lives. Get event notifications, chat with members, ask questions, and
            participate in discussions and activities.
          </p>
          <a
            href="https://discord.com/invite/duca"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-block font-medium text-purple-400 transition-colors hover:text-purple-300"
          >
            Discord &rarr;
          </a>
        </div>

        <div
          class="theme-card theme-border relative rounded-2xl border p-8 text-center transition-all duration-300 hover:-translate-y-1 hover:border-cyan-500/30"
        >
          <div
            class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full border border-cyan-500/30 bg-cyan-500/10"
          >
            <span class="text-3xl font-bold text-cyan-400">3</span>
          </div>
          <h3 class="theme-text mb-3 text-xl font-bold">Show Up &amp; Get Involved</h3>
          <p class="theme-text-secondary">
            Attend workshops, join a division, compete in CTFs, or just hang out. DUCA is what you make of it - everyone
            is welcome regardless of experience level.
          </p>
          <a href="/events/" class="mt-4 inline-block font-medium text-cyan-400 transition-colors hover:text-cyan-300">
            Browse events &rarr;
          </a>
        </div>
      </div>

      <!-- What You Get -->
      <div
        class="theme-border mt-16 rounded-2xl border p-8"
        style="background: linear-gradient(135deg, rgba(236,72,153,0.05), rgba(139,92,246,0.05), rgba(6,182,212,0.05));"
      >
        <h3 class="theme-text mb-6 text-center text-2xl font-bold">What You Get as a Member</h3>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <div class="flex items-start gap-3">
            <span class="text-2xl">🎓</span>
            <div>
              <h4 class="theme-text font-semibold">Workshops & Training</h4>
              <p class="theme-text-muted text-sm">Hands-on learning in cybersecurity, networking, and development</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-2xl">🏆</span>
            <div>
              <h4 class="theme-text font-semibold">CTF Competitions</h4>
              <p class="theme-text-muted text-sm">Compete in capture-the-flag events as part of a team</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-2xl">🤝</span>
            <div>
              <h4 class="theme-text font-semibold">Industry Connections</h4>
              <p class="theme-text-muted text-sm">Network with professionals and explore career opportunities</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-2xl">🌐</span>
            <div>
              <h4 class="theme-text font-semibold">Community</h4>
              <p class="theme-text-muted text-sm">800+ members who share your passion for cybersecurity</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Discord Section -->
  <section class="section-themed theme-border border-t py-24">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
        <WobbleCard containerClassName="bg-purple-900 min-h-[300px]" client:visible>
          <h2 class="mb-4 text-2xl font-bold text-white md:text-3xl">Join Our Discord</h2>
          <p class="mb-6 text-purple-200">
            Our Discord server is the heart of our community. Connect with 800+ members, get event updates, ask
            questions, and participate in discussions.
          </p>
          <a
            href="https://discord.com/invite/duca"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3 font-semibold text-purple-900 transition-colors hover:bg-gray-100"
          >
            Discord
          </a>
        </WobbleCard>

        <WobbleCard containerClassName="bg-cyan-900 min-h-[300px]" client:visible>
          <h2 class="mb-4 text-2xl font-bold text-white md:text-3xl">DUSA Membership</h2>
          <p class="mb-6 text-cyan-200">
            Official club membership through DUSA gives you voting rights, access to all events, and supports the club's
            activities.
          </p>
          <a
            href="https://www.dusa.org.au/clubs/deakin-university-cybersecurity-association-burwood-duca"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3 font-semibold text-cyan-900 transition-colors hover:bg-gray-100"
          >
            Regsiter
          </a>
        </WobbleCard>
      </div>
    </div>
  </section>

  <!-- Join the Team Section -->
  <section class="section-themed theme-border border-t py-24">
    <div class="container mx-auto px-4">
      <SectionHeading title="Join the Team" subtitle="Want to contribute? Join one of our divisions!" client:visible />

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          divisions.map((division) => (
            <CardSpotlight radius={300} color={division.color} className="h-full" client:visible>
              <div class="relative z-10">
                <div class="mb-4 text-4xl">{division.icon}</div>
                <h3 class="theme-text mb-2 text-xl font-bold">{division.title}</h3>
                <p class="theme-text-secondary">{division.description}</p>
              </div>
            </CardSpotlight>
          ))
        }
      </div>

      <div class="mt-12 text-center">
        <p class="theme-text-secondary mb-6">Interested in joining a division? Reach out to us on Discord!</p>
        <a
          href="https://discord.com/invite/duca"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-full bg-slate-800 px-6 py-3 font-semibold text-white transition-colors hover:bg-slate-700"
        >
          Discord
        </a>
      </div>
    </div>
  </section>
</DefaultLayout>

<!-- Theme styling handled by DefaultLayout -->
