---
import BaseLayout from '../layouts/BaseLayout.astro';
import DesignSite from '../components/DesignSite.jsx';
import { getEvents, toEventData } from '../lib/events';
import { getBlogPosts, toBlogCard } from '../lib/blog';
import { getDiscordMemberCount } from '../lib/discord-members.js';
import { navigationPages } from '../data/site-content';
import { getPageMetadata } from '../data/metadata';
import { getBlogPageCount, getBlogPageUrl } from '../lib/blog-pagination';
import { getTeamImages } from '../lib/team-images';

export function getStaticPaths() {
  return navigationPages.filter(page => page.id !== 'home')
    .map(({ id: page, label }) => ({ params: { page }, props: { page, label } }));
}

const { page, label } = Astro.props;
const metadata = getPageMetadata(page);
const posts = (await getBlogPosts()).map(toBlogCard);
const events = (await getEvents()).map(toEventData);
const discordMemberCount = await getDiscordMemberCount();
const teamImages = page === 'team' ? await getTeamImages() : undefined;
---

<BaseLayout
  title={metadata.title}
  description={metadata.description}
  nextPage={page === 'blog' && getBlogPageCount(posts.length) > 1 ? getBlogPageUrl(1) : undefined}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: label, url: `/${page}/` }]}
>
  <DesignSite discordMemberCount={discordMemberCount} events={events} initialNow={Date.now()} initialPage={page} posts={posts} teamImages={teamImages} client:load />
</BaseLayout>
