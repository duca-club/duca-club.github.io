---
import BaseLayout from '../layouts/BaseLayout.astro';
import DesignSite from '../components/DesignSite.jsx';
import { getEvents, toEventData } from '../lib/events';
import { getBlogPosts, toBlogCard } from '../lib/blog';
import { getDiscordMemberCount } from '../lib/discord-members.js';
import { navigationPages } from '../data/site-content';
import { siteConfig } from '../data/site';

export function getStaticPaths() {
  return navigationPages.filter(page => page.id !== 'home')
    .map(({ id: page, label }) => ({ params: { page }, props: { page, label } }));
}

const { page, label } = Astro.props;
const posts = (await getBlogPosts()).map(toBlogCard);
const events = (await getEvents()).map(toEventData);
const discordMemberCount = await getDiscordMemberCount();
---

<BaseLayout title={`${label} — ${siteConfig.name}`}>
  <DesignSite discordMemberCount={discordMemberCount} events={events} initialNow={Date.now()} initialPage={page} posts={posts} client:load />
</BaseLayout>
