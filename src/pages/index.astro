---
import BaseLayout from '../layouts/BaseLayout.astro';
import DesignSite from '../components/DesignSite.jsx';
import { getBlogPosts, toBlogCard } from '../lib/blog';

const posts = (await getBlogPosts()).map(toBlogCard);
---

<BaseLayout>
  <DesignSite initialNow={Date.now()} initialPage="home" posts={posts} client:load />
</BaseLayout>
