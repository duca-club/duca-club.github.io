---
import DefaultLayout from "@layouts/DefaultLayout.astro";
import { SpotlightNew } from "@components/ui/spotlight";
import { FlipWords } from "@components/ui/flip-words";
import ProjectsShowcaseSection from "@components/sections/ProjectsShowcaseSection";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import jingleShellsPoster from "@assets/images/projects/project-image-JingleShellsCTF2.png";

// Run cover images through getImage() so Astro emits the optimized asset. Passing
// a raw importedImage.src as a string prop to the client:load island loses Astro's
// asset tracking, so the base file never gets written and 404s in the build.
const jinglePoster = await getImage({ src: jingleShellsPoster, format: "webp", width: 800 });
const projectImages: Record<string, string> = {
  "project-jingleshells": jinglePoster.src,
};

// Get projects from content collection, excluding starter-template placeholders.
const allProjects = (await getCollection("projects")).filter((p) => p.data.author !== "John Doe");

const projects = allProjects.map((p) => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  tags: p.data.tags,
  author: p.data.author,
  image: projectImages[p.id],
}));

const flipWords = ["build", "break", "secure", "ship"];
---

<DefaultLayout title="Projects">
  <!-- Hero Section -->
  <section class="section-themed relative flex min-h-[50vh] items-center justify-center overflow-hidden pt-40">
    <div class="absolute inset-0 bg-linear-to-b from-emerald-900/20 via-transparent to-transparent"></div>
    <SpotlightNew className="-top-40 right-0 md:-top-20 md:right-60" fill="#10b981" client:load />
    <div class="bg-grid-pattern absolute inset-0"></div>

    <!-- Twinkling stars for idle motion -->
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <span class="animate-star-twinkle-1 absolute top-[22%] left-[12%] h-1 w-1 rounded-full bg-emerald-300/80"></span>
      <span class="animate-star-twinkle-2 absolute top-[35%] left-[28%] h-0.5 w-0.5 rounded-full bg-cyan-300/70"></span>
      <span class="animate-star-twinkle-3 absolute top-[18%] left-[62%] h-1 w-1 rounded-full bg-emerald-200/60"></span>
      <span class="animate-star-twinkle-1 absolute top-[48%] left-[78%] h-0.5 w-0.5 rounded-full bg-cyan-200/70"></span>
      <span class="animate-star-twinkle-2 absolute top-[60%] left-[18%] h-1 w-1 rounded-full bg-emerald-300/50"></span>
      <span class="animate-star-twinkle-3 absolute top-[70%] left-[52%] h-0.5 w-0.5 rounded-full bg-emerald-200/70"></span>
      <span class="animate-star-twinkle-1 absolute top-[30%] left-[88%] h-1 w-1 rounded-full bg-cyan-300/60"></span>
      <span class="animate-star-twinkle-2 absolute top-[75%] left-[85%] h-0.5 w-0.5 rounded-full bg-emerald-300/60"></span>
    </div>

    <div class="relative z-10 container mx-auto px-4 py-20 text-center">
      <h1 class="mb-6 text-5xl font-bold md:text-7xl">
        <span class="a11y-gradient-text bg-linear-to-r from-emerald-400 to-cyan-500 bg-clip-text text-transparent"
          >Projects</span
        >
      </h1>
      <p class="theme-text-secondary mx-auto mb-8 max-w-2xl text-xl">
        Where DUCA members
        <FlipWords words={flipWords} className="font-semibold text-emerald-400" client:load />
        real things — explore the projects created by our development team and community.
      </p>
    </div>
  </section>

  <!-- Projects Showcase -->
  <section class="section-themed data-stream-bg relative overflow-hidden border-t border-slate-800/40 py-24">
    <div class="relative z-10 container mx-auto px-4">
      <noscript>
        <div class="mb-8 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-5 text-sm text-emerald-100">
          JavaScript is disabled. Showing a static list of projects.
        </div>
        {
          projects.length > 0 ? (
            <ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
              {projects.map((project) => (
                <li class="theme-card rounded-xl border p-5">
                  <a href={`/portfolio/${project.id}/`} class="theme-text text-xl font-semibold">
                    {project.title}
                  </a>
                  <p class="theme-text-muted mt-1 text-sm">by {project.author}</p>
                  <p class="theme-text-secondary mt-2 text-sm">{project.description}</p>
                </li>
              ))}
            </ul>
          ) : (
            <p class="theme-text-secondary text-center">No projects to show yet. Check back soon!</p>
          )
        }
      </noscript>

      <div class="js-only">
        <ProjectsShowcaseSection projects={projects} client:load />
      </div>
    </div>
  </section>

  <!-- Contribute CTA -->
  <section class="section-themed data-stream-bg relative overflow-hidden border-t border-slate-800/40 py-24">
    <div class="relative z-10 container mx-auto px-4 text-center">
      <div
        class="animate-pulse-glow-emerald mx-auto max-w-2xl rounded-2xl border-2 border-emerald-500/30 bg-linear-to-br from-emerald-900/20 to-black p-12"
      >
        <h2 class="theme-text mb-6 text-3xl font-bold md:text-4xl">Want to contribute?</h2>
        <p class="theme-text-secondary mx-auto mb-8 max-w-2xl">
          Join the DUCA Development Division and work on exciting projects with a supportive team. No experience
          required - just bring your curiosity!
        </p>
        <div class="flex flex-col justify-center gap-4 sm:flex-row">
          <a
            href="/join/"
            class="inline-flex items-center justify-center rounded-full bg-emerald-600 px-6 py-3 font-semibold text-white transition-colors hover:bg-emerald-700"
          >
            Join Us
          </a>
          <a
            href="https://github.com/duca-club"
            target="_blank"
            rel="noopener noreferrer"
            class="theme-text inline-flex items-center justify-center rounded-full border-2 border-emerald-500 px-6 py-3 font-semibold transition-colors hover:bg-emerald-500/10"
          >
            View GitHub
          </a>
        </div>
      </div>
    </div>
  </section>
</DefaultLayout>
