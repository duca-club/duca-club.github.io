---

<DefaultLayout title="Meet The Team">
  <!-- Hero Section -->
  <section class="relative flex min-h-[40vh] items-center justify-center overflow-hidden">
    <AuroraBackground className="absolute inset-0 h-full!" showRadialGradient={false} client:load>
      <div></div>
    </AuroraBackground>
    <div class="absolute inset-0 z-10 flex items-center justify-center px-4 py-20">
      <div class="text-center">
        <h1 class="mb-6 text-5xl font-bold text-white md:text-7xl">
          <span class="bg-linear-to-r from-purple-400 to-pink-500 bg-clip-text text-transparent">Meet The Team</span>
        </h1>
        <p class="mx-auto max-w-3xl text-xl text-gray-300 md:text-2xl">
          We're a bunch of curious, passionate people building a welcoming space for everyone - come see what we get up
          to!
        </p>
      </div>
    </div>
  </section>

  <!-- Executives -->
  <section class="section-themed py-24">
    <div class="container mx-auto px-4">
      <SectionHeading title="Executives" subtitle="The leadership team driving DUCA forward" client:visible />
      <TeamGrid members={executives} className="mt-12" client:visible />
    </div>
  </section>

  <!-- Divisions -->
  {
    divisions.map((division, divIdx) => (
      <section
        class={`section-themed py-20 ${divIdx % 2 === 0 ? "border-t border-purple-500/10" : "border-t border-slate-700/30"}`}
      >
        <div class="container mx-auto px-4">
          <SectionHeading title={division.name} subtitle={division.description} client:visible />

          <TeamGrid members={division.members} className="mt-8" client:visible />
        </div>
      </section>
    ))
  }

  <!-- CTA -->
  <section class="section-themed data-stream-bg relative overflow-hidden border-t border-purple-500/10 py-24">
    <div class="relative z-10 container mx-auto px-4 text-center">
      <h2 class="mb-6 text-3xl font-bold text-white md:text-4xl">Want to join the team?</h2>
      <p class="mx-auto mb-8 max-w-2xl text-gray-400">
        We're always looking for passionate people to help grow DUCA. Whether you want to lead, build, hack, or create -
        there's a place for you.
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="https://www.dusa.org.au/clubs/deakin-university-cybersecurity-association-burwood-duca"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-full bg-purple-600 px-6 py-3 font-semibold text-white transition-colors hover:bg-purple-700"
        >
          Regsiter
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center rounded-full border-2 border-purple-500 px-6 py-3 font-semibold text-white transition-colors hover:bg-purple-500/10"
        >
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</DefaultLayout>
