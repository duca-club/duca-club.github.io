---
import DefaultLayout from "@layouts/DefaultLayout.astro";
import { AuroraBackground } from "@components/ui/aurora-background";
import MeetTheTeamSection from "@components/sections/MeetTheTeamSection";
---

<DefaultLayout title="Meet The Team">
  <!-- Interactive Year Switcher + Team Lists (including integrated Hero) -->
  <MeetTheTeamSection client:load />

  <!-- CTA -->
  <section class="section-themed data-stream-bg relative overflow-hidden border-t border-purple-500/10 py-24">
    <div class="relative z-10 container mx-auto px-4 text-center">
      <h2 class="mb-6 text-3xl font-bold text-white md:text-4xl">Want to join the team?</h2>
      <p class="mx-auto mb-8 max-w-2xl text-gray-400">
        We're always looking for passionate people to help grow DUCA. Whether you want to lead, build, hack, or create -
        there's a place for you.
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="https://www.dusa.org.au/clubs/deakin-university-cybersecurity-association-burwood-duca"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-full bg-purple-600 px-6 py-3 font-semibold text-white transition-colors hover:bg-purple-700"
        >
          Regsiter
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center justify-center rounded-full border-2 border-purple-500 px-6 py-3 font-semibold text-white transition-colors hover:bg-purple-500/10"
        >
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</DefaultLayout>
